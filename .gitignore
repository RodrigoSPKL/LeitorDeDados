# Dados e arquivos recebidos nunca entram por um git add amplo.
*.zip
*.rar
*.7z
*.tar
*.gz
*.bz2
*.xz
*.csv
*.tsv
*.jsonl
*.ndjson
*.sql
*.dump
*.bak
*.txt
!requirements.txt
!requirements-dev.txt
!requirements.lock.txt

# Somente os exemplos fictícios versionados são permitidos.
!examples/registros.csv
!examples/registros.jsonl

# Configurações reais da empresa devem permanecer locais.
/config/*
!/config/*.example.json

# Credenciais e material criptográfico local.
*.pem
*.key
*.p12
*.pfx
*.jks
